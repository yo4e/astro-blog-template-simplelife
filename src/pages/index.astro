---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// 記事全件を取得し、order順に並び替え
const posts = (await getCollection("posts")).sort(
	(a, b) => a.data.order - b.data.order,
);

const title = "Simple Life Log";
const description =
	"シンプルで豊かな暮らしを探求するブログ。断捨離、デジタルデトックス、マインドフルネスなど、心地よい毎日を送るためのヒントを発信します。";
---

<Layout title={title} description={description}>
	<section class="mb-16 text-center">
		<h1
			class="text-4xl md:text-5xl font-bold tracking-tight mb-6 leading-tight"
		>
			{title}
		</h1>
		<p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
			Less is more.<br />
			必要なものだけで、豊かに暮らす。<br />
			日々の気づきと実践の記録。
		</p>
	</section>

	<img
		src="/images/hero.png"
		alt="Simple Life Log"
		class="w-full mx-auto mb-16 rounded-md shadow-md"
	/>

	<section>
		<h2
			class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-8 text-center"
		>
			Table of Contents
		</h2>
		<div class="space-y-8">
			{
				posts.map((post) => (
					<article class="group relative bg-white border border-gray-100 hover:border-gray-300 transition-colors p-6 rounded-sm shadow-sm hover:shadow-md">
						<div class="flex flex-col md:flex-row md:items-baseline gap-2 mb-2">
							<span class="text-xs font-mono text-gray-400 uppercase tracking-wider shrink-0">
								Chapter {post.data.order}
							</span>
							<h3 class="text-xl font-bold group-hover:text-monolith-dark transition-colors">
								<span>
									<span>
										{post.data.title.replace(
											/^Simple Life Chapter \d+: /,
											"",
										)}
									</span>
								</span>
							</h3>
						</div>
						<p class="text-gray-600 leading-relaxed mb-4">
							{post.data.description}
						</p>
						<div class="text-right">
							<span class="inline-block text-sm font-bold border-b border-black pb-0.5 group-hover:opacity-70 transition-opacity">
								Read Logic &rarr;
							</span>
						</div>
						<a
							href={`/posts/${post.slug}/`}
							class="absolute inset-0"
							aria-label={`Read ${post.data.title}`}
						/>
					</article>
				))
			}
		</div>
	</section>
</Layout>
