---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 日本語コメント:
// サイト全体の共通レイアウトです。
// すべてのページはこのレイアウトを使用します。

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}

const { title, description, image, ogType, publishedTime, modifiedTime } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <Head
      title={title}
      description={description}
      image={image}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-screen bg-monolith-white text-monolith-black font-sans">
    <Header />
    <!-- メインコンテンツ -->
    <!-- flex-growでフッターを最下部に押し下げる -->
    <!-- containerとmax-w-3xlで読みやすい幅に制限 -->
    <main class="flex-grow container mx-auto px-4 py-12 max-w-3xl">
      <slot />
    </main>
    <Footer />
  </body>
</html>
