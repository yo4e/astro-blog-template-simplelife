---
import { SITE_TITLE } from "../consts";
// 日本語コメント:
// シンプルなヘッダーコンポーネント
---

<header
  class="w-full border-b border-monolith-dark/10 bg-monolith-white/90 backdrop-blur-sm sticky top-0 z-50"
>
  <div
    class="container mx-auto px-4 py-4 max-w-3xl flex justify-between items-center"
  >
    <a
      href="/"
      class="text-xl font-bold tracking-tight hover:opacity-70 transition-opacity"
    >
      {SITE_TITLE}
    </a>
    <nav class="flex gap-4 text-sm font-medium text-gray-600">
      <a href="/about" class="hover:text-black transition-colors">About</a>
      <a href="/privacy-policy" class="hover:text-black transition-colors"
        >Privacy</a
      >
    </nav>
  </div>
</header>
